DATABASE_URL=postgres://postgres@127.0.0.1:5432/app
# Groq API key for the AI assistant and the agents (server only).
GROQ_API_KEY=gsk_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

JWT_SECRET=change-me-to-a-long-random-string
# Exposed to the browser (Next requires the NEXT_PUBLIC_ prefix) so the
# PlaygroundBridge island can mount inside the playground iframe.
NEXT_PUBLIC_IS_PLAYGROUND=true

# Xendit hosted checkout. Set these in Railway Variables, never in client code.
XENDIT_SECRET_KEY=xnd_development_XXXXXXXXXXXXXXXX
XENDIT_WEBHOOK_TOKEN=replace-with-the-callback-verification-token
# Register this callback URL in the Xendit Dashboard:
# https://cyber-wealth-web-production.up.railway.app/api/webhooks/xendit

# Manual payment instructions shown to buyers (no payment gateway required)
BANK_NAME=
BANK_ACCOUNT_NAME=
BANK_ACCOUNT_NUMBER=
BANK_TRANSFER_INSTRUCTIONS=Silakan transfer ke rekening resmi pemilik. Cantumkan kode pesanan pada berita transfer.
